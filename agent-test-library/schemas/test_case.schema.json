{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/schemas/agent-test-case.json",
  "title": "Agent Test Case",
  "description": "Single test case definition consumable by an agent testing application",
  "type": "object",
  "required": ["id", "name", "category", "tags", "input", "expected"],
  "properties": {
    "id": {
      "type": "string",
      "description": "Unique stable identifier",
      "pattern": "^[a-z0-9][a-z0-9_\\-]{2,64}$"
    },
    "name": {
      "type": "string",
      "description": "Human readable short name"
    },
    "description": {
      "type": "string",
      "description": "What this test is trying to discover or break"
    },
    "category": {
      "type": "string",
      "enum": [
        "identification",
        "capability",
        "tool_use",
        "multi_turn",
        "instruction_following",
        "robustness",
        "safety",
        "hallucination",
        "ambiguity",
        "edge_case"
      ]
    },
    "tags": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Free-form tags for filtering (e.g. smoke, regression, red-team)"
    },
    "priority": {
      "type": "string",
      "enum": ["critical", "high", "medium", "low"],
      "default": "medium"
    },
    "input": {
      "type": "object",
      "required": ["messages"],
      "properties": {
        "messages": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["role", "content"],
            "properties": {
              "role": {
                "type": "string",
                "enum": ["system", "user", "assistant"]
              },
              "content": {
                "type": "string"
              }
            }
          }
        },
        "tools": {
          "type": "array",
          "description": "Optional list of tool names or full tool schemas the agent should see for this test",
          "items": {
            "oneOf": [
              { "type": "string" },
              { "type": "object" }
            ]
          }
        },
        "metadata": {
          "type": "object",
          "description": "Any extra context your runner needs (locale, user_id, etc.)"
        }
      }
    },
    "expected": {
      "type": "object",
      "description": "Contracts the runner can assert against",
      "properties": {
        "must_call_tools": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Tool names that must appear in the trace"
        },
        "must_not_call_tools": {
          "type": "array",
          "items": { "type": "string" }
        },
        "tool_call_count": {
          "type": "object",
          "properties": {
            "min": { "type": "integer", "minimum": 0 },
            "max": { "type": "integer", "minimum": 0 }
          }
        },
        "final_response": {
          "type": "object",
          "properties": {
            "must_contain": {
              "type": "array",
              "items": { "type": "string" }
            },
            "must_not_contain": {
              "type": "array",
              "items": { "type": "string" }
            },
            "json_schema": {
              "type": "object",
              "description": "If the agent is expected to return structured JSON"
            },
            "max_length_chars": { "type": "integer" },
            "min_length_chars": { "type": "integer" }
          }
        },
        "behavior": {
          "type": "object",
          "properties": {
            "should_refuse": { "type": "boolean" },
            "should_ask_clarification": { "type": "boolean" },
            "should_be_grounded": { "type": "boolean" },
            "should_follow_format": { "type": "boolean" }
          }
        },
        "rubric": {
          "type": "object",
          "description": "Soft scoring dimensions (1-5). Runner or judge decides pass threshold.",
          "properties": {
            "correctness": { "type": "number" },
            "relevance": { "type": "number" },
            "instruction_adherence": { "type": "number" },
            "safety": { "type": "number" },
            "conciseness": { "type": "number" }
          }
        }
      }
    },
    "notes": {
      "type": "string",
      "description": "Internal notes for the test author"
    }
  },
  "additionalProperties": false
}
